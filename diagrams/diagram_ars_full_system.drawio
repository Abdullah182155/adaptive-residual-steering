<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_ars_full_system" name="Adaptive Residual Steering"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Adaptive Residual Steering" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="Research workflow: verified data → fixed adapter → route bank and router → matched evaluation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;1  ·  TRAINING DATA&lt;/b&gt;&lt;br&gt;&lt;br&gt;GSM8K official train&lt;br&gt;7,473 source questions&lt;br&gt;5,000 sampled for collection&lt;br&gt;Question-level split&lt;br&gt;0 / 2 / 4-shot contexts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;2  ·  VERIFIED ROLLOUTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;2 initial attempts per question&lt;br&gt;Retry only if zero strict positives&lt;br&gt;Up to 2 targeted retries&lt;br&gt;Deduplicate correct reasoning&lt;br&gt;Keep up to 2 positives per question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;3  ·  FIXED ADAPTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Frozen Phi-2 backbone&lt;br&gt;Rank 16 residual module&lt;br&gt;Route 12 / 15 / 18 / 21&lt;br&gt;Train on verified completions&lt;br&gt;p99 update bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="552" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;4  ·  ROUTE BANK&lt;/b&gt;&lt;br&gt;&lt;br&gt;14 candidate layer locations&lt;br&gt;Routes with k = 1, 2, 3, 4&lt;br&gt;Minimum layer gap: 3&lt;br&gt;Independent route experts&lt;br&gt;Screen and select on held-out data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="814" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;5  ·  PROMPT ROUTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt-only features&lt;br&gt;Score route × gain actions&lt;br&gt;Include no steering (k = 0)&lt;br&gt;Fit measured action scores&lt;br&gt;Select using task validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1076" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;6  ·  EVALUATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Four matched arms&lt;br&gt;0-shot and 2-shot primary&lt;br&gt;Shot and transfer slices&lt;br&gt;Paired deltas and uncertainty&lt;br&gt;Answer quality and runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1338" y="265" width="230" height="370" as="geometry" /></mxCell><mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell>