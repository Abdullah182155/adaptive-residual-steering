<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_route_bank" name="Independent Route Bank"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Independent Route Bank" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="A staged search reduces the combinatorial space while keeping one separately trained expert per retained route" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;CANDIDATE LAYERS&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 · 11 · 12 · 13&lt;br&gt;15 · 17 · 18 · 19&lt;br&gt;20 · 21 · 22 · 23&lt;br&gt;24 · 26&lt;br&gt;14 locations from Stage A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="26" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;ROUTE CONSTRAINTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Route size k = 1…4&lt;br&gt;Minimum layer gap = 3&lt;br&gt;Separate control gap = 2&lt;br&gt;No adjacent-layer pairs&lt;br&gt;Caps bound retained routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="288" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;CURRICULUM&lt;/b&gt;&lt;br&gt;&lt;br&gt;Train all singletons&lt;br&gt;Screen spaced pairs&lt;br&gt;Expand selected subsets&lt;br&gt;Screen triples, then quads&lt;br&gt;Keep up to 8 per size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;ROUTE EXPERTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Initialize larger routes&lt;br&gt;from trained subsets&lt;br&gt;Copy into route-specific weights&lt;br&gt;Fine-tune each expert separately&lt;br&gt;No shared expert weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="812" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;TRAINING SIGNAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Token-mean NLL on positives&lt;br&gt;Matched same-prompt pairs&lt;br&gt;add softplus preference loss&lt;br&gt;λ_pref = 0.25&lt;br&gt;Only use pairs when available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1074" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;HELD-OUT SELECTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Screen each route on validation rows&lt;br&gt;Use preference evidence when present&lt;br&gt;Choose a static route and gain&lt;br&gt;Separate task-accuracy screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1336" y="285" width="230" height="390" as="geometry" /></mxCell><mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>