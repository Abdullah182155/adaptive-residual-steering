<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_static_vs_dynamic" name="Three Steering Policies Answer Different Questions"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Three Steering Policies Answer Different Questions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="A fixed route is a reference; a static bank tests bank quality; the router tests prompt-conditioned action choice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;FIXED STEERING&lt;/b&gt;&lt;br&gt;&lt;br&gt;One trained route&lt;br&gt;One calibrated gain&lt;br&gt;Same action for every question&lt;br&gt;&lt;br&gt;Question tested:&lt;br&gt;Does a learned residual update&lt;br&gt;help compared with no steering?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="240" width="450" height="470" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;STATIC BANK&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose one bank route and gain&lt;br&gt;on held-out data&lt;br&gt;Reuse that action for all questions&lt;br&gt;&lt;br&gt;Question tested:&lt;br&gt;Does the bank contain a better&lt;br&gt;general-purpose action?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="575" y="240" width="450" height="470" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;PROMPT ROUTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read each question&amp;#x27;s prompt features&lt;br&gt;Select route and gain per question&lt;br&gt;May choose no steering (k = 0)&lt;br&gt;&lt;br&gt;Question tested:&lt;br&gt;Can prompt context identify which&lt;br&gt;action helps this question?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1095" y="240" width="450" height="470" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>