<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_paired_evaluation" name="Matched Four-Arm Evaluation"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Matched Four-Arm Evaluation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="Every arm receives the same question IDs, shot condition, prompt schedule, and decoding settings" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;SHARED TEST SET&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same question IDs&lt;br&gt;Same shot condition&lt;br&gt;Same prompt schedule&lt;br&gt;Same decoding settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="350" width="280" height="230" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;1  ·  BASELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Frozen Phi-2, no intervention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="330" height="125" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;2  ·  FIXED STEERING&lt;/b&gt;&lt;br&gt;&lt;br&gt;One route and calibrated gain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="330" height="125" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;3  ·  STATIC BANK&lt;/b&gt;&lt;br&gt;&lt;br&gt;One held-out-selected action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="330" height="125" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;4  ·  ROUTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt-specific route and gain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="330" height="125" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;PAIRED RESULT RECORD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per-question outcomes&lt;br&gt;Wins · losses · ties · Δ percentage points&lt;br&gt;Bootstrap 95% interval and McNemar test&lt;br&gt;Answer format and quality checks&lt;br&gt;Latency, tokens, route usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1050" y="310" width="485" height="390" as="geometry" /></mxCell><mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geomet