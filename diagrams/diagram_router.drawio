<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_router" name="Router: Separate Offline Learning from Test-Time Choice"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Router: Separate Offline Learning from Test-Time Choice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="Teacher scoring and validation happen during training; inference sees only the prompt and selects a route–gain action" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;OFFLINE 1  ·  TEACHER SCORES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Score route–gain actions&lt;br&gt;on router-training prompts&lt;br&gt;Add route cost: 0.01 × k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="350" height="230" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;OFFLINE 2  ·  TARGETS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normalize action scores per prompt&lt;br&gt;Retain preference ordering&lt;br&gt;Store prompt/action supervision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="185" width="350" height="230" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;OFFLINE 3  ·  FIT POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;RouteValueRouter predicts action scores&lt;br&gt;Smooth-L1 score regression&lt;br&gt;plus KL teacher preference loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="185" width="350" height="230" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;OFFLINE 4  ·  SELECT CHECKPOINT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Up to 3 epochs / 2,048 rows&lt;br&gt;Separate task validation: up to 84 rows&lt;br&gt;Restore best selected checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="185" width="350" height="230" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;INFERENCE 1  ·  INPUT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question plus demonstration context&lt;br&gt;No generated completion&lt;br&gt;No gold answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="350" height="230" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;INFERENCE 2  ·  FEATURES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pooled valid prompt-token states&lt;br&gt;Normalized shot count&lt;br&gt;Normalized question-token count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="525" width="350" height="230" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;INFERENCE 3  ·  SCORE CATALOG&lt;/b&gt;&lt;br&gt;&lt;br&gt;No-op plus bank routes&lt;br&gt;Each route paired with gain&lt;br&gt;α = 1 / 1.25 / 1.5 / 1.75 / 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="525" width="350" height="230" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;INFERENCE 4  ·  APPLY ACTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose one route and gain&lt;br&gt;Set steering before generation&lt;br&gt;Generate answer with frozen Phi-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="525" width="350" height="230" as="geometry" /></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>