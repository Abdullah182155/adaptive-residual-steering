<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="diagram_rollout_collection" name="Building the Fixed-Adapter Training Set"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Building the Fixed-Adapter Training Set" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=32;fontColor=#FF7A00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1490" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="A strict-positive gate spends retries on questions that produced no verified correct answer initially" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="82" width="1490" height="42" as="geometry" /></mxCell><mxCell id="2" value="&lt;b&gt;SOURCE QUESTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sampled from GSM8K train&lt;br&gt;Stable question ID&lt;br&gt;Assign 0 / 2 / 4-shot context&lt;br&gt;Use diversified prompt wording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="255" height="380" as="geometry" /></mxCell><mxCell id="3" value="&lt;b&gt;INITIAL SAMPLING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate 2 completions&lt;br&gt;Temperature 0.7&lt;br&gt;top_p = 0.95&lt;br&gt;Record prompt, answer, and seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="255" height="380" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;STRICT VERIFICATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check final answer and format&lt;br&gt;Keep strict-positive attempts&lt;br&gt;If at least one is correct:&lt;br&gt;no retry is needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="670" y="290" width="255" height="380" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;TARGETED RETRY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only when initial strict positives = 0&lt;br&gt;Generate up to 2 more attempts&lt;br&gt;Temperature 0.9&lt;br&gt;Keep retry provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FF7A00;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="255" height="380" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;TRAINING ROWS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deduplicate by reasoning key&lt;br&gt;Keep at most 2 distinct positives&lt;br&gt;Prompt and padding excluded from loss&lt;br&gt;Save shard and validation statistics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A00;strokeColor=#FF7A00;fontColor=#000000;fontFamily=Calibri;fontSize=22;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="255" height="380" as="geometry" /></mxCell><mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;html=1;strokeColor=#FF7A00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=16;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>